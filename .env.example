# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cbo

# Redis
REDIS_URL=redis://localhost:6379

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth
# Set to a strong random value when ENVIRONMENT=production
SECRET_KEY=
ENVIRONMENT=development

# CORS: JSON array of allowed browser origins (for production, the web app's Railway URL)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Groq AI (get a free key at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT_SECONDS=60.0
CHAT_COMPLETION_TIMEOUT_SECONDS=30.0

# Fuzzy matching thresholds for product name matching
FUZZY_MATCH_THRESHOLD=0.78
FUZZY_TIE_THRESHOLD=0.05

# AI rate limiting (per-user, in-memory sliding window)
AI_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_HOUR=200
